<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Arena" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="colorPrimary">@color/teal</item>
        <item name="colorOnPrimary">@color/teal_ink</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Arena.BottomSheet" parent="Theme.Material3.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Arena.BottomSheet</item>
    </style>

    <style name="Widget.Arena.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/panel</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Arena.BottomSheet</item>
    </style>

    <style name="ShapeAppearance.Arena.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">22dp</item>
        <item name="cornerSizeTopRight">22dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
