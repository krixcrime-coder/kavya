<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="32dp">

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="18dp"
        android:src="@drawable/logo_full"
        android:scaleType="centerCrop"
        android:background="@drawable/rounded_panel" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/text_main"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tagline"
        android:textColor="@color/text_dim"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"/>

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnNewProject"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/new_project"
        android:textAllCaps="false"
        android:textColor="@color/teal_ink"
        android:textStyle="bold"
        android:textSize="16sp"
        android:background="@drawable/btn_primary"
        android:elevation="0dp"
        app:icon="@drawable/ic_add"
        style="@style/Widget.Material3.Button.Icon"
        app:iconTint="@color/teal_ink"
        app:iconGravity="textStart"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="ARENA · PERSONAL EDITOR"
        android:textColor="@color/text_dim"
        android:textSize="11sp"
        android:gravity="center"
        android:fontFamily="monospace"/>

</LinearLayout>
