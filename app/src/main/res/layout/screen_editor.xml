<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenEditor"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#050506"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBackEditor"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/rounded_panel"
            android:src="@drawable/ic_back"
            android:padding="8dp"
            android:contentDescription="Back"/>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

        <TextView
            android:id="@+id/tvRatioLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="9:16"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:fontFamily="monospace"/>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

        <Button
            android:id="@+id/btnExport"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/export"
            android:textAllCaps="false"
            android:textColor="@color/teal_ink"
            android:textStyle="bold"
            android:textSize="13sp"
            android:background="@drawable/btn_primary"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/stage"
            android:layout_width="240dp"
            android:layout_height="420dp"
            android:layout_gravity="center"
            android:background="@android:color/black">

            <VideoView
                android:id="@+id/mainVideo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>

        <TextView
            android:id="@+id/toast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="18dp"
            android:background="@drawable/rounded_panel"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:textColor="@color/text_main"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="invisible"
            android:elevation="12dp"/>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/propPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/panel"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:text="SIZE"
                android:textColor="@color/text_dim"
                android:textSize="11sp"
                android:fontFamily="monospace"/>

            <SeekBar
                android:id="@+id/propSize"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="62"
                android:progress="12"
                android:progressTint="@color/teal"
                android:thumbTint="@color/teal"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:text="LOCK"
                android:textColor="@color/text_dim"
                android:textSize="11sp"
                android:fontFamily="monospace"/>

            <Switch
                android:id="@+id/propLock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Drag to edit  →  Locked in place"
                android:textColor="@color/text_dim"
                android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/panel"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/trayWatermark"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:padding="6dp"
            android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_watermark" android:layout_marginBottom="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Watermark" android:textColor="@color/text_dim" android:textSize="10.5sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/trayCaption"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:padding="6dp"
            android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_caption" android:layout_marginBottom="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Caption" android:textColor="@color/text_dim" android:textSize="10.5sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/traySticker"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:padding="6dp"
            android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_sticker" android:layout_marginBottom="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sticker" android:textColor="@color/text_dim" android:textSize="10.5sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/trayDelete"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:padding="6dp"
            android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_delete" android:layout_marginBottom="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Delete" android:textColor="@color/text_dim" android:textSize="10.5sp"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
