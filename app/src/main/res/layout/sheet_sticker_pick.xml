<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/panel"
    android:padding="22dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/line"
        android:layout_marginBottom="18dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pick a sticker"
        android:textColor="@color/text_main"
        android:textSize="17sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <GridLayout
        android:id="@+id/stickerGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="5"
        android:rowCount="2"
        android:layout_marginBottom="18dp">

        <ImageButton android:id="@+id/stk_fire" android:layout_width="0dp" android:layout_height="52dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/chip_bg" android:src="@drawable/ic_fire" android:scaleType="centerInside" android:contentDescription="fire"/>
        <ImageButton android:id="@+id/stk_heart" android:layout_width="0dp" android:layout_height="52dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/chip_bg" android:src="@drawable/ic_heart" android:scaleType="centerInside" android:contentDescription="heart"/>
        <ImageButton android:id="@+id/stk_star" android:layout_width="0dp" android:layout_height="52dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/chip_bg" android:src="@drawable/ic_star" android:scaleType="centerInside" android:contentDescription="star"/>
        <ImageButton android:id="@+id/stk_thumb" android:layout_width="0dp" android:layout_height="52dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/chip_bg" android:src="@drawable/ic_thumb_up" android:scaleType="centerInside" android:contentDescription="thumb up"/>
        <ImageButton android:id="@+id/stk_flag" android:layout_width="0dp" android:layout_height="52dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/chip_bg" android:src="@drawable/ic_flag" android:scaleType="centerInside" android:contentDescription="flag"/>

        <ImageButton android:id="@+id/stk_flash" android:layout_width="0dp" android:layout_height="52dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/chip_bg" android:src="@drawable/ic_flash" android:scaleType="centerInside" android:contentDescription="flash"/>
        <ImageButton android:id="@+id/stk_rocket" android:layout_width="0dp" android:layout_height="52dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/chip_bg" android:src="@drawable/ic_rocket" android:scaleType="centerInside" android:contentDescription="rocket"/>
        <ImageButton android:id="@+id/stk_eye" android:layout_width="0dp" android:layout_height="52dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/chip_bg" android:src="@drawable/ic_eye" android:scaleType="centerInside" android:contentDescription="eye"/>
        <ImageButton android:id="@+id/stk_check" android:layout_width="0dp" android:layout_height="52dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/chip_bg" android:src="@drawable/ic_check_circle" android:scaleType="centerInside" android:contentDescription="check"/>
        <ImageButton android:id="@+id/stk_pin" android:layout_width="0dp" android:layout_height="52dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/chip_bg" android:src="@drawable/ic_pin" android:scaleType="centerInside" android:contentDescription="pin"/>
    </GridLayout>

    <Button
        android:id="@+id/btnStickerSave"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Add to video"
        android:textAllCaps="false"
        android:textColor="@color/teal_ink"
        android:textStyle="bold"
        android:background="@drawable/btn_primary"/>

</LinearLayout>
