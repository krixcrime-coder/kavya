<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenCrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/btnBackCrop"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/rounded_panel"
            android:src="@drawable/ic_back"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="Back"/>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STEP 3 / 3"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:fontFamily="monospace"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FRAME"
        android:textColor="@color/teal"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:paddingStart="20dp"
        android:layout_marginTop="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/step_crop_title"
        android:textColor="@color/text_main"
        android:textSize="22sp"
        android:textStyle="bold"
        android:paddingStart="20dp"
        android:layout_marginTop="4dp"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <FrameLayout
            android:id="@+id/cropFrame"
            android:layout_width="240dp"
            android:layout_height="420dp"
            android:layout_gravity="center"
            android:background="@android:color/black">

            <VideoView
                android:id="@+id/cropVideo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </FrameLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="20dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipAuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto centre · black bars"
                android:textColor="@color/teal"
                android:textSize="12.5sp"
                android:fontFamily="monospace"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/chip_bg"
                android:selected="true"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/chipFill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fill frame · crop edges"
                android:textColor="@color/text_dim"
                android:textSize="12.5sp"
                android:fontFamily="monospace"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:background="@drawable/chip_bg"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </HorizontalScrollView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="20dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipCrop43"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crop 4:3"
                android:textColor="@color/text_dim"
                android:textSize="12.5sp"
                android:fontFamily="monospace"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/chip_bg"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/chipCrop11"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crop 1:1"
                android:textColor="@color/text_dim"
                android:textSize="12.5sp"
                android:fontFamily="monospace"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/chip_bg"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/chipCropFree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Free crop"
                android:textColor="@color/text_dim"
                android:textSize="12.5sp"
                android:fontFamily="monospace"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:background="@drawable/chip_bg"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <Button
            android:id="@+id/btnCropNext"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/continue_label"
            android:textAllCaps="false"
            android:textColor="@color/teal_ink"
            android:textStyle="bold"
            android:background="@drawable/btn_primary"/>
    </LinearLayout>

</LinearLayout>
