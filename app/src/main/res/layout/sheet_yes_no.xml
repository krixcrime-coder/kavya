<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/panel"
    android:padding="22dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/line"
        android:layout_marginBottom="18dp"/>

    <TextView
        android:id="@+id/sheetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ask_watermark_title"
        android:textColor="@color/text_main"
        android:textSize="17sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:id="@+id/sheetHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ask_watermark_hint"
        android:textColor="@color/text_dim"
        android:textSize="13sp"
        android:layout_marginBottom="20dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnNo"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/no_thanks"
            android:textAllCaps="false"
            android:textColor="@color/text_main"
            android:textStyle="bold"
            android:background="@drawable/rounded_panel"/>

        <Button
            android:id="@+id/btnYes"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/yes_add_one"
            android:textAllCaps="false"
            android:textColor="@color/teal_ink"
            android:textStyle="bold"
            android:background="@drawable/btn_primary"/>
    </LinearLayout>

</LinearLayout>
