<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenSize"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/btnBackSize"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/rounded_panel"
            android:src="@drawable/ic_back"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:contentDescription="Back"/>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STEP 1 / 3"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:fontFamily="monospace"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXPORT SIZE"
                android:textColor="@color/teal"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:fontFamily="monospace"
                android:layout_marginTop="14dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/step_size_title"
                android:textColor="@color/text_main"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/card916"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/rounded_panel_selected">
                    <View android:layout_width="34dp" android:layout_height="60dp" android:background="@color/panel2" android:layout_marginBottom="10dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9:16" android:textColor="@color/text_main" android:textStyle="bold" android:fontFamily="monospace"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reels / Shorts" android:textColor="@color/text_dim" android:textSize="11sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card169"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/rounded_panel_selected">
                    <View android:layout_width="60dp" android:layout_height="34dp" android:background="@color/panel2" android:layout_marginBottom="10dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="16:9" android:textColor="@color/text_main" android:textStyle="bold" android:fontFamily="monospace"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="YouTube / TV" android:textColor="@color/text_dim" android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/card11"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/rounded_panel_selected">
                    <View android:layout_width="46dp" android:layout_height="46dp" android:background="@color/panel2" android:layout_marginBottom="10dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1:1" android:textColor="@color/text_main" android:textStyle="bold" android:fontFamily="monospace"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Feed post" android:textColor="@color/text_dim" android:textSize="11sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card43"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/rounded_panel_selected">
                    <View android:layout_width="52dp" android:layout_height="39dp" android:background="@color/panel2" android:layout_marginBottom="10dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4:3" android:textColor="@color/text_main" android:textStyle="bold" android:fontFamily="monospace"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Classic" android:textColor="@color/text_dim" android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btnMoreRatios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="More ratios ▾"
                android:textColor="@color/text_dim"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="12dp"
                android:layout_marginTop="6dp"
                android:clickable="true"
                android:focusable="true"/>

            <LinearLayout
                android:id="@+id/moreRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/card34"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="5dp"
                    android:orientation="vertical" android:gravity="center" android:padding="14dp"
                    android:clickable="true" android:focusable="true" android:background="@drawable/rounded_panel_selected">
                    <View android:layout_width="36dp" android:layout_height="48dp" android:background="@color/panel2" android:layout_marginBottom="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3:4" android:textColor="@color/text_main" android:textStyle="bold" android:fontFamily="monospace" android:textSize="12sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card23"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="5dp" android:layout_marginEnd="5dp"
                    android:orientation="vertical" android:gravity="center" android:padding="14dp"
                    android:clickable="true" android:focusable="true" android:background="@drawable/rounded_panel_selected">
                    <View android:layout_width="34dp" android:layout_height="51dp" android:background="@color/panel2" android:layout_marginBottom="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2:3" android:textColor="@color/text_main" android:textStyle="bold" android:fontFamily="monospace" android:textSize="12sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/card219"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="5dp"
                    android:orientation="vertical" android:gravity="center" android:padding="14dp"
                    android:clickable="true" android:focusable="true" android:background="@drawable/rounded_panel_selected">
                    <View android:layout_width="63dp" android:layout_height="27dp" android:background="@color/panel2" android:layout_marginBottom="8dp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="21:9" android:textColor="@color/text_main" android:textStyle="bold" android:fontFamily="monospace" android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@color/bg">
        <Button
            android:id="@+id/btnSizeNext"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/continue_label"
            android:textAllCaps="false"
            android:textColor="@color/teal_ink"
            android:textStyle="bold"
            android:background="@drawable/btn_primary"
            android:enabled="false"
            android:alpha="0.35"/>
    </LinearLayout>

</LinearLayout>
