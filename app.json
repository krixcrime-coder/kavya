{
  "expo": {
    "name": "Kavya 2.0",
    "slug": "kavya-assistant",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kavya",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "updates": {
      "checkAutomatically": "NEVER"
    },
    "android": {
      "package": "com.personal.kavya",
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "CALL_PHONE",
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "com.android.alarm.permission.SET_ALARM",
        "CAMERA",
        "SYSTEM_ALERT_WINDOW",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "READ_CONTACTS",
        "WRITE_CONTACTS",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "REQUEST_INSTALL_PACKAGES",
        "QUERY_ALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08061A"
      }
    },
    "plugins": [
      "expo-router",
      "./plugins/withSpeechQueries",
      [
        "expo-camera",
        {
          "cameraPermission": "Kavya needs camera access to scan QR codes and barcodes."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Kavya needs microphone access for hands-free voice commands.",
          "speechRecognitionPermission": "Kavya needs speech recognition access to understand your voice commands."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
